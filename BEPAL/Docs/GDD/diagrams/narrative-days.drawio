se" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;endArrow=block;endSize=7;strokeWidth=2;strokeColor=light-dark(#333333,#cccccc);labelBackgroundColor=default;fontColor=light-dark(#333333,#cccccc);fontFamily=Tahoma,Leelawadee UI,Trebuchet MS,sans-serif;fontSize=16;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2-choice" target="d2-end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-d2-choice-d2-combat" value="Tame" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;endArrow=block;endSize=7;strokeWidth=2;strokeColor=light-dark(#333333,#cccccc);labelBackgroundColor=default;fontColor=light-dark(#333333,#cccccc);fontFamily=Tahoma,Leelawadee UI,Trebuchet MS,sans-serif;fontSize=16;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2-choice" target="d2-combat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-d2-combat-d3-merchant" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;endArrow=block;endSize=7;strokeWidth=2;strokeColor=light-dark(#333333,#cccccc);labelBackgroundColor=default;fontColor=light-dark(#333333,#cccccc);fontFamily=Tahoma,Leelawadee UI,Trebuchet MS,sans-serif;fontSize=16;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2-combat" target="d3-merchant"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-d2-end-d3-merchant" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;endArrow=block;endSize=7;strokeWidth=2;strokeColor=light-dark(#333333,#cccccc);labelBackgroundColor=default;fontColor=light-dark(#333333,#cccccc);fontFamily=Tahoma,Leelawadee UI,Trebuchet MS,sans-serif;fontSize=16;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2-end" target="d3-merchant