<mxfile host="app.diagrams.net"><diagram name="Win/Lose &amp; Core Game Flow" id="wl"><mxGraphModel dx="1406" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="wl-T" value="Flow Chart: Win/Lose Condition &amp; Core Game Flow (BePal Prototype)" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontSize=28;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);" vertex="1" parent="1"><mxGeometry x="-40" y="-55" width="1600" height="50" as="geometry"/></mxCell><mxCell id="wl-A" value="เริ่มเกม&lt;br&gt;Play → เลือกสัตว์ตัวแรก (ไอ่แดง / ไอ่ซุง / ไอ่เขียว)" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="340" y="39" width="520" height="82" as="geometry"/></mxCell><mxCell id="wl-B" value="เริ่มวันใหม่ (Day N)&lt;br&gt;+100 coin · Energy รีเซ็ต · Stomach −20 · Clean −15" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1" parent="1"><mxGeometry x="360" y="168" width="480" height="84" as="geometry"/></mxCell><mxCell id="wl-C" value="ช่วงดูแลที่ฐาน (ใช้ Energy)&lt;br&gt;Feed / Clean / Train / Heal · Upgrade · หมอ · สมุด" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1" parent="1"><mxGeometry x="360" y="308" width="480" hei